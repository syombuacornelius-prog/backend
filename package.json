{
  "name": "visiontec-computer-shop-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "node node_modules/tailwindcss/lib/cli.js -i ./src/tailwind.css -o ./dist/tailwind.css",
    "watch:css": "node node_modules/tailwindcss/lib/cli.js -i ./src/tailwind.css -o ./dist/tailwind.css --watch",
